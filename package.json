{
  "name": "plato-workspace",
  "private": true,
  "version": "0.1.0",
  "description": "Plato — AI coding agent with live mid-flight supervision (Applivity)",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "build": "tsc -b && pnpm --filter plato run bundle",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "render": "node scripts/render/run.mjs",
    "render:fast": "SKIP_BUILD=1 node scripts/render/run.mjs",
    "verify": "pnpm run build && pnpm test && pnpm run render"
  },
  "devDependencies": {
    "@types/node": "24.3.1",
    "typescript": "5.9.2"
  }
}
