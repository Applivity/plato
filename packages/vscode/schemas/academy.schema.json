{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Plato academy definition (D31/D32)",
  "type": "object",
  "required": [
    "members"
  ],
  "properties": {
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "model"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Member name, unique in the team"
          },
          "model": {
            "type": "string",
            "description": "Model ref as <connection>:<model>, e.g. anthropic:claude-sonnet-4-5"
          },
          "role": {
            "type": "string",
            "description": "Extra system text for this member"
          },
          "kind": {
            "type": "string",
            "enum": [
              "worker",
              "philosopher"
            ],
            "default": "worker",
            "description": "Exactly one worker; up to 5 philosophers"
          },
          "guidance": {
            "type": "boolean",
            "default": true,
            "description": "Philosopher tier: may inject guidance"
          },
          "pause": {
            "type": "boolean",
            "default": false,
            "description": "Philosopher tier: may pause the run"
          },
          "cancel": {
            "type": "boolean",
            "default": false,
            "description": "Philosopher tier: may cancel the run"
          },
          "maxInterventions": {
            "type": "integer",
            "minimum": 0,
            "default": 5,
            "description": "Philosopher tier: per-member intervention budget (run-wide cap 5)"
          }
        },
        "additionalProperties": false
      }
    },
    "academy": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Display name of the team"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}