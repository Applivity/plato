{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Plato academy definition (D47e)",
  "type": "object",
  "required": [
    "members"
  ],
  "properties": {
    "members": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "name",
          "model"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Philosopher name, unique in the council"
          },
          "model": {
            "type": "string",
            "description": "Model ref as <connection>:<model>, e.g. anthropic:claude-sonnet-4-5"
          },
          "role": {
            "type": "string",
            "maxLength": 1000,
            "description": "Extra system text for this philosopher (max 1000 characters; one line)"
          },
          "persona": {
            "type": "string",
            "description": "Optional persona id (aristotle, heraclitus, diogenes, pythagoras, thales) — supplies the default name and role"
          },
          "color": {
            "type": "string",
            "enum": [
              "violet",
              "blue",
              "teal",
              "amber",
              "rose"
            ],
            "description": "Identity colour for this philosopher, shown in Settings, the chat notices and the run-start team card. Assigned once when the philosopher is created."
          },
          "guidance": {
            "type": "boolean",
            "default": true,
            "description": "Always on: every philosopher can speak (D47d)"
          },
          "pause": {
            "type": "boolean",
            "default": false,
            "description": "Philosopher tier: may pause the run"
          },
          "cancel": {
            "type": "boolean",
            "default": false,
            "description": "Philosopher tier: may cancel the run"
          },
          "maxInterventions": {
            "type": "integer",
            "minimum": 0,
            "default": 5,
            "description": "Philosopher tier: per-member intervention budget (run-wide cap 5)"
          }
        },
        "additionalProperties": false
      }
    },
    "academy": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Display name of the council"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}