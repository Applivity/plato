{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Plato team definition (D31)",
  "type": "object",
  "required": ["members"],
  "properties": {
    "team": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Display name of the team"
        }
      },
      "additionalProperties": false
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "model"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Member name, unique in the team"
          },
          "model": {
            "type": "string",
            "description": "Model ref as <connection>:<model>, e.g. anthropic:claude-sonnet-4-5"
          },
          "role": {
            "type": "string",
            "description": "Extra system text for this member"
          },
          "kind": {
            "type": "string",
            "enum": ["coder", "observer"],
            "default": "coder",
            "description": "Exactly one coder; up to 3 observers"
          },
          "guidance": {
            "type": "boolean",
            "default": true,
            "description": "Observer tier: may inject guidance"
          },
          "pause": {
            "type": "boolean",
            "default": false,
            "description": "Observer tier: may pause the run"
          },
          "cancel": {
            "type": "boolean",
            "default": false,
            "description": "Observer tier: may cancel the run"
          },
          "maxInterventions": {
            "type": "integer",
            "minimum": 0,
            "default": 5,
            "description": "Observer tier: per-member intervention budget (run-wide cap 5)"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
