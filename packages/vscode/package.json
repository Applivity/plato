{
  "name": "plato-vscode",
  "version": "0.3.0",
  "private": true,
  "description": "Plato VS Code extension — thin shell over @applivity/plato-core",
  "publisher": "applivity",
  "displayName": "Plato",
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "tsc -b && node esbuild.mjs",
    "bundle": "node esbuild.mjs",
    "test": "node -e \"console.log('no unit tests in the shell; core carries the logic')\"",
    "package": "pnpm vsce package --no-dependencies"
  },
  "contributes": {
    "commands": [
      {
        "command": "plato.openChat",
        "title": "Plato: Open Chat"
      },
      {
        "command": "plato.setApiKey",
        "title": "Plato: Set API Key"
      },
      {
        "command": "plato.newChat",
        "title": "Plato: New Chat"
      }
    ],
    "configuration": {
      "title": "Plato",
      "properties": {
        "plato.model": {
          "type": "string",
          "default": "anthropic:claude-sonnet-4-5",
          "description": "Default model as provider:model (e.g. openai:gpt-4o-mini). The header dropdown overrides this per chat."
        },
        "plato.reasoning": {
          "type": "string",
          "enum": ["off", "low", "medium", "high"],
          "default": "off",
          "description": "Reasoning effort for models that support it (o4-mini, Claude extended thinking). Ignored otherwise."
        },
        "plato.openAiBaseUrl": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "description": "Base URL for OpenAI-compatible endpoints (OpenRouter, Ollama, self-hosted)."
        }
      }
    }
  },
  "dependencies": {
    "@applivity/plato-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.3.1",
    "@types/vscode": "1.103.0",
    "@vscode/vsce": "3.6.0",
    "esbuild": "0.25.10",
    "typescript": "5.9.2"
  }
}
