# --- Secrets (mirrors the deny-list in docs/ARCHITECTURE.md) ---
# Never commit key material or local environment files.
.env*
*.keystore
*.jks
keystore.properties
local.properties
# Named one by one, NOT `secrets.*`. That glob was here until 2026-09-25 and it
# matched `security/secrets.ts` — the deny-list IMPLEMENTATION, which imports
# nothing secret and is imported by six modules. The effect was that the file
# never entered the repository at all: no history, no review, and a fresh clone
# that cannot build. An ignore rule that can swallow SOURCE is the wrong shape,
# so no wildcard returns here. If you add a local secret file, name it.
secrets.json
secrets.yaml
secrets.yml
secrets.toml

# --- Node / pnpm ---
node_modules/

# Visual Studio VSIX build outputs and the staged Node sidecar
packages/vs/src/Plato.Vs/bin/
packages/vs/src/Plato.Vs/obj/
packages/vs/src/Plato.Vs/sidecar/*
!packages/vs/src/Plato.Vs/sidecar/README.md
.vs/
.pnpm-store/

# --- TypeScript build output ---
dist/
out/
build/
*.tsbuildinfo

# --- Test & coverage ---
coverage/

# --- Build-time scratch (e.g. node --check of the inline webview script) ---
tmp/

# --- VS Code extension packaging ---
*.vsix

# --- VS Code local workspace state (keep shared settings if added later) ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json

# --- Logs ---
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# --- Misc editor / OS noise ---
.DS_Store
Thumbs.db
.idea/

# --- Working notes (not committed by design) ---
# docs/telemetry-notes.md says in its own header that it is not committed. The
# durable part moves into DECISIONS.md when the founder decides, and the note
# goes away.
docs/telemetry-notes.md

